# Used for local uvicorn. Docker Compose overrides DATABASE_URL to reach the db service.
DATABASE_URL=postgresql+psycopg2://raqs:raqs@localhost:5434/raqs_is

JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
